upstream origin {
  server app:3000;
}

map $http_upgrade $connection_upgrade {
  default upgrade;
  "" close;
}

include /etc/nginx/zuco-cache/http/*.conf;

server {
  listen 80;
  server_name ${ZUCO_SERVER_NAMES};

  location ^~ /.well-known/acme-challenge/ {
    root /usr/share/nginx/html;
    try_files $uri =404;
  }

  location / {
    return 301 https://$server_name$request_uri;
  }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${ZUCO_SERVER_NAMES};

  ssl_certificate /etc/letsencrypt/live/${ZUCO_CERT_NAME}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${ZUCO_CERT_NAME}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;

  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options "nosniff";
  add_header X-Frame-Options "SAMEORIGIN";
  add_header X-XSS-Protection "1; mode=block";

  location / {
    proxy_pass http://origin;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    include /etc/nginx/zuco-cache/location/*.conf;
  }
}
